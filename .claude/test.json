{
  "_comment": [
    "Diagnostic surface for the verify step. This project is a Discord bot, and",
    "it is a SINGLETON: one Discord token, one data/state.json, one data/bot.pid.",
    "Starting a second instance from a build worktree would fight the live bot",
    "for the gateway connection and corrupt shared state.",
    "",
    "So verification here does NOT boot its own copy. It drives the bot that is",
    "already running (scripts/discord_test.py talks to it over real webhooks and",
    "reads back what it actually rendered), checks health from the log, and runs",
    "the standalone harnesses for pure display/parse logic.",
    "",
    "Only use 'start'/'stop' if the log check reports the bot is DOWN."
  ],

  "project_type": "bot",
  "singleton": true,

  "health": "python scripts/smoke_test.py",
  "start": "python scripts/botctl.py start",
  "stop": "python scripts/botctl.py stop",
  "_platform_note": [
    "start/stop/logs go through scripts/botctl.py, which works on both Linux",
    "and Windows. start/stop used to name start_bot.bat / stop_bot.bat -- files",
    "that do not exist on Linux, so verify could never recover a bot it found",
    "down. logs.tail used to be 'tail -n 50', which does not exist on Windows.",
    "The .bat wrappers are kept for double-clicking from Explorer."
  ],

  "logs": {
    "file": "data/logs/bot.log",
    "tail": "python scripts/botctl.py logs 50",
    "failure_markers": ["ERROR", "CRITICAL", "Traceback"]
  },

  "interact": {
    "list_channels": "python scripts/discord_test.py list-channels",
    "list_threads": "python scripts/discord_test.py list-threads <forum_id>",
    "send": "python scripts/discord_test.py send <channel_or_thread_id> <message>",
    "read": "python scripts/discord_test.py read <channel_or_thread_id> [limit]",
    "wait_response": "python scripts/discord_test.py wait-response <channel_id> [timeout] [after_msg_id]",
    "suite": "python scripts/discord_test.py run-suite",
    "_note": [
      "send/read go through TEST_WEBHOOK_URL / TEST_LOBBY_WEBHOOK_URL and are",
      "treated as user messages (TEST_WEBHOOK_IDS bypasses the bot-author guard),",
      "so this is a genuine end-to-end action -> observe loop against the live bot.",
      "'read' returns message content, embeds and buttons — which is how you check",
      "what a result message actually RENDERED, not just that it was sent.",
      "",
      "Feed the message id 'send' prints into wait-response as after_msg_id. The",
      "bot answers in about two seconds, so without it the baseline is taken",
      "after the reply already arrived and a healthy bot reads as unresponsive.",
      "Ark replies also self-delete after 15s, and the probe message is deleted",
      "once handled — so a probe that has VANISHED is proof it was handled."
    ]
  },

  "harnesses": {
    "_note": "Standalone runners for logic with no live surface. Exit 0 = pass. 'all' runs every scripts/test_*, verify_* and check_portability serially by glob, so a harness missing from this list still runs there. test_session_cgroups is deliberately absent: it creates real systemd scopes and runs daemon-reload.",
