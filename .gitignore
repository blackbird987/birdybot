# Runtime data
data/

# Environment
.env
# The migration script writes .env.<platform>.bak alongside it — same secrets,
# same blast radius, and they were one `git add -A` away from being published.
.env.*.bak

# Generated by scripts/install_desktop_launcher.sh with this checkout's
# absolute path baked in, so it is machine-specific by construction.
*.desktop

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Claude Code — ignore local state (settings.local.json, deploy.json, ...)
# but keep skills trackable. Must be `.claude/*` not `.claude/`: git cannot
# re-include (!) children of an excluded DIRECTORY, only of a glob. The old
# `.claude/` form silently dropped skills from worktree merges.
#
# test.json is shared repo config, not local state: build/verify steps run in
# a fresh worktree, so an untracked copy would simply not be there — the same
# silent drop the skills note above describes.
.claude/*
!.claude/skills/
!.claude/test.json

# Git worktrees (build isolation)
.worktrees/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Personal one-off scripts (not bot code — kept on disk, out of the repo)
scripts/make_hypotheek_dossier.py
